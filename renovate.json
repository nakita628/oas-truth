{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":separateMultipleMajorReleases",
    "security:openssf-scorecard"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": ["* * * * 6"],
  "dependencyDashboardAutoclose": true,
  "osvVulnerabilityAlerts": true,
  "platformAutomerge": false,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": ["* * * * 6"]
  },
  "packageRules": [
    {
      "matchDatasources": ["npm", "github-actions"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "TypeSpec ships every @typespec/* package in one release and the packages require each other's version as peers, so they move in one PR: majors are not split from minors / patches, nor from each other.",
      "matchPackageNames": ["@typespec/**"],
      "groupName": "typespec",
      "separateMajorMinor": false,
      "separateMultipleMajor": false
    },
    {
      "matchUpdateTypes": ["pin", "pinDigest"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["digest"],
      "automerge": false
    }
  ]
}
