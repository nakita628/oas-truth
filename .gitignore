.env
.env.*
!.env.example

# OS / editor
.DS_Store
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea

# Local Claude Code settings (the shared .claude/settings.json stays committable)
.claude/settings.local.json
